# ==========================================
# Dayfold Production Environment Configuration
# ==========================================

# Application
APP_NAME="Dayfold"
APP_VERSION="0.1.0"
ENVIRONMENT="production"
DEBUG=false

# Security
# Generate a cryptographically secure 32+ char key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY="replace-with-secure-random-secret-key"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM="HS256"

# Database (PostgreSQL 15+)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql+asyncpg://postgres:your_password@localhost:5432/dayfold_prod"
DATABASE_URL_SYNC="postgresql://postgres:your_password@localhost:5432/dayfold_prod"

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=["https://dayfold.vercel.app", "https://dayfold.app"]

# Gemini AI (Server-Side Only - NEVER expose to client)
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-2.0-flash"
GEMINI_EXTRACT_MODEL="gemini-2.0-flash"

# Rate Limiting
AI_REQUESTS_PER_HOUR=60
AI_REQUESTS_PER_DAY=200

# Frontend URL
FRONTEND_URL="https://dayfold.vercel.app"

