# Dayfold Backend Environment Configuration
# Copy this file to .env and fill in your values

# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME=Dayfold
ENVIRONMENT=development
DEBUG=true

# ─── Security ─────────────────────────────────────────────────────────────────
# In production, must be at least 32 cryptographically secure characters
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dayfold-local-development-secret-key-32chars-min

# ─── Database ─────────────────────────────────────────────────────────────────
# Development: SQLite (local file, zero setup)
DATABASE_URL=sqlite+aiosqlite:///./dayfold.db
DATABASE_URL_SYNC=sqlite:///./dayfold.db

# Production: Neon PostgreSQL Free Tier (SSL required)
# DATABASE_URL=postgresql+asyncpg://neondb_owner:password@ep-xyz.us-east-2.aws.neon.tech/neondb?ssl=require
# DATABASE_URL_SYNC=postgresql://neondb_owner:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require

# ─── Distributed Redis (Required in Production) ──────────────────────────────
# In development, leave blank or omit to use thread-safe in-memory store.
# In production: Upstash Redis Free Tier (TLS enabled)
# REDIS_URL=rediss://default:your-token@your-endpoint.upstash.io:6379

# ─── AI ───────────────────────────────────────────────────────────────────────
# Get free API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EXTRACT_MODEL=gemini-3.6-flash

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Production: set to your Vercel deployment URL
# CORS_ORIGINS=["https://dayfold.vercel.app"]
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
