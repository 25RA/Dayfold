# Dayfold Root Environment Configuration Overview
# For specific service configuration, see:
# - backend/.env.example (FastAPI backend, database, Redis, Gemini AI)
# - frontend/.env.example (Vite frontend, API proxy URL)

# ─── Mode ────────────────────────────────────────────────────────────────────
APP_NAME=Dayfold
ENVIRONMENT=development
DEBUG=true

# ─── Quick Start ─────────────────────────────────────────────────────────────
# 1. Backend:
#    cd backend
#    cp .env.example .env
#    # Configure GEMINI_API_KEY and SECRET_KEY in backend/.env
#
# 2. Frontend:
#    cd frontend
#    # In local development, frontend proxies directly to backend on :8000

